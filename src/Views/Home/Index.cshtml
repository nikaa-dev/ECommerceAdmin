@{
    Layout = "../Shared/_LoginLayout";
}
@model src.DTO.AuthDto.LoginDto

@if (TempData["Message"] != null)
{
    <script>
        alert('@TempData["Message"]');
    </script>
}

<style>
    :root {
        /* Modern Admin Dashboard Color Palette */
        --primary-bg: #0f172a; /* Slate 900 - Dark professional background */
        --primary-color: #2563eb; /* Royal Blue */
        --primary-hover: #1d4ed8;
        --text-dark: #1e293b;
        --text-gray: #64748b;
        --bg-light: #f8fafc;
        --border-color: #e2e8f0;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: var(--bg-light);
    }

    .login-layout {
        display: flex;
        flex-direction: row;
        min-height: 100vh;
        width: 100%;
    }

    /* Left Side: Form */
    .login-layout__left {
        width: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: #ffffff;
        padding: 2rem;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
    }

    /* Header & Icon */
    /* Header & Icon */
    /* Header & Icon */
    .login-header {
        display: flex;
        flex-direction: column; /* Stacks items vertically */
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-bottom: 2.5rem;
        width: 100%;
        height: auto; /* Overrides any restricted height squishing the layout */
        gap: 8px; /* Creates perfect spacing between the icon, title, and subtitle */
    }

    .login-header__icon {
        background: rgba(37, 99, 235, 0.1);
        color: var(--primary-color);
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0; /* Absolutely prevents the icon from squishing into a pill */
        margin-bottom: 0.5rem;
    }

    .login-header__title h2 {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.75rem;
        margin: 0; /* Reset margin, gap handles the spacing */
        line-height: 1.2;
    }

    .login-header__subtitle p {
        color: var(--text-gray);
        font-size: 0.95rem;
        margin: 0; /* Reset margin */
    }
    /* Form Elements */
    .form-group {
        margin-bottom: 1.5rem;
        width: 100%;
    }

        .form-group label {
            display: block;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

    .input-wrapper {
        position: relative;
        display: block;
        width: 100%;
    }

        .input-wrapper i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-gray);
            font-size: 1.1rem;
            z-index: 10;
            pointer-events: none; /* Prevents the icon from blocking your mouse clicks */
            margin: 0;
            padding: 0;
        }

    .form-input-field {
        display: block; /* Forces block layout for perfect width */
        width: 100%;
        height: 50px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        padding-left: 45px;
        padding-right: 15px;
        font-size: 0.95rem;
        color: var(--text-dark);
        transition: all 0.2s ease;
        background-color: var(--bg-light);
    }

        .form-input-field:focus {
            outline: none;
            border-color: var(--primary-color);
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

    /* Buttons */
    .login-submit-btn {
        display: block; /* Matches the input display type */
        width: 100%;
        height: 50px;
        background: var(--primary-color);
        border: none;
        border-radius: 8px; /* Added to match the inputs exactly */
        font-weight: 600;
        font-size: 1rem;
        color: white;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 1rem;
    }

        .login-submit-btn:hover {
            background: var(--primary-hover);
        }

    /* Right Side: Branding */
    .login-layout__right {
        width: 50%;
        background: var(--primary-bg);
        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 3rem;
        position: relative;
        overflow: hidden;
    }

        /* Subtle geometric background accents for admin feel */
        .login-layout__right::before {
            content: '';
            position: absolute;
            top: -20%;
            right: -10%;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, rgba(15, 23, 42, 0) 70%);
        }

        .login-layout__right::after {
            content: '';
            position: absolute;
            bottom: -10%;
            left: -10%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.1) 0%, rgba(15, 23, 42, 0) 70%);
        }

    .title-wrapper {
        max-width: 500px;
        z-index: 1;
    }

        .title-wrapper h1 {
            font-weight: 700;
            font-size: 3rem;
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }

        .title-wrapper p.desc {
            font-size: 1.1rem;
            color: #94a3b8;
            margin-bottom: 3rem;
            line-height: 1.6;
        }

    /* Features List */
    .features-container {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.03);
        padding: 1rem 1.5rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .feature-icon {
        background: rgba(37, 99, 235, 0.2);
        color: #60a5fa;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.2rem;
    }

    .feature-text h4 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #e2e8f0;
    }

    .feature-text span {
        font-size: 0.85rem;
        color: #94a3b8;
    }

    /* Responsive Design for Mobile & Tablets */
    @@media (max-width: 992px) {
        .login-layout__right {
            display: none;
        }

        .login-layout__left {
            width: 100%;
        }
        /* Header & Icon */
        .login-header {
            text-align: center; /* Centers the title and subtitle text */
            margin-bottom: 2.5rem;
        }

        .login-header__icon {
            background: rgba(37, 99, 235, 0.1);
            color: var(--primary-color);
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 1.5rem auto; /* The 'auto' on left/right centers the lock box */
        }
    }
</style>

<div class="login-layout">

    <!-- LEFT SIDE -->
    <div class="login-layout__left">
        <div class="login-card">

            <!-- ICON & HEADER -->
            <!-- ICON & HEADER -->
            <div class="login-header">

                <!-- Shield Icon -->
                <div class="login-header__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5" />
                    </svg>
                </div>

                <!-- Title -->
                <div class="login-header__title">
                    <h2>Admin Portal</h2>
                </div>

                <!-- Subtitle -->
                <div class="login-header__subtitle">
                    <p>Sign in to access your dashboard</p>
                </div>

            </div>

            <!-- FORM -->
            <form class="login-form" method="post">

                <!-- EMAIL -->
                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="text" required asp-for="UsernameOrEmail" class="form-input-field shadow-none" placeholder="admin@domain.com" autocomplete="email">
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="form-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input required type="password" asp-for="Password" class="form-input-field shadow-none" placeholder="Enter your password" autocomplete="current-password">
                    </div>
                </div>

                <!-- SIGNIN BUTTON -->
                <button class="login-submit-btn" type="submit">
                    Sign in to Dashboard
                </button>

            </form>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="login-layout__right">
        <div class="title-wrapper">

            <!-- HEADING -->
            <h1>E-Commerce<br />Management</h1>

            <!-- DESCRIPTION -->
            <p class="desc">
                Centralized control for your entire online business. Track orders, manage inventory, and oversee customers seamlessly.
            </p>

            <!-- FEATURES LIST -->
            <div class="features-container">

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Real-Time Analytics</h4>
                        <span>Monitor sales and store performance</span>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <div class="feature-text">
                        <h4>Inventory Control</h4>
                        <span>Manage products and stock levels</span>
                    </div>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div class="feature-text">
                        <h4>User Management</h4>
                        <span>Handle customers and staff roles</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>