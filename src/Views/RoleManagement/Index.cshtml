<!-- View (Index.cshtml) -->
@using System.ComponentModel.Design
@using src.Enums
@model src.Extensions.Pagenations.PagedResult<src.DTO.RoleDto.RoleResponseDto>

@if (TempData["Message"] != null)
{
    <div>@TempData["Message"]</div>
}

<style>
    :root {
        --primary-bg-color: linear-gradient(to bottom right, #10b981 0%, #14b8a6 50%, #0891b2 100%);
        --text-gray: #9ca3af;
    }

    p {
        color: #6c757d;
    }             

    .bi-three-dots-vertical:hover {
        background-color: #f3f4f6;
    }

    .form-search:focus {
        outline: none; /* Remove default outline */

        box-shadow: 0 0 0 3px lightgray; /* Add a custom "ring" using box-shadow */
    }

    .shadow-sm {
        box-shadow: 1px 1px 1px 1px rgba(0, 0, 0, 0.3);
    }

    .custom-gradient {
        background: linear-gradient(to bottom right, #3b82f6, #8b5cf6);
        color: white;
    }

    .modal-header,
    .modal-footer {
        border: none !important;
    }

    .form-input {
        color: var(--text-gray);
    }

    .form-input-field {
        width: 100%;
        border-radius: 10px;
    }

    .role-stat-card {
        min-height: 110px;
    }
</style>
<div class="">
    <div class="d-flex justify-content-between">
        @* heading *@
        <div>
            <h3>Role Management</h3>
            <p>Manage roles and permissions for your admin system</p>
            
        </div>

        @* add role *@

        <div>
            <form id="export-role" method="post" class="gap-2">
                <button type="submit" class="btn border rounded-10">
                    <i class="bi bi-download"></i>
                    <span class="fw-light">Export</span>
                </button>
                <button type="submit" class="btn btn-primary rounded-10" role="button" data-toggle="modal" data-target="#add-role">
                    <i class="bi bi-plus-lg"></i>
                    <span class="fw-light">Add Role</span>
                </button>
            </form>
        </div>

        <!-- add role Modal -->
        <div class="modal fade" id="add-role" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width:50%; margin:auto;" role="document">
                <div class="modal-content">
                    <form id="add-role-permission">

                        <div class="modal-header flex-column align-items-start mx-2">
                            <h5 class="modal-title fw-semibold" id="exampleModalLabel">
                                Add New Role
                            </h5>
                            <p class="text-muted mb-0">Create a new role with specific permissions.</p>
                            <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true" class="fs-5">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body mx-2" style="max-height:60vh; overflow-y:auto;">
                            <div class="d-flex align-items-start flex-column justify-content-between">
                                <div class="d-flex align-items-start flex-column w-100 mb-2">

                                    <label formlabel="Full Name">Role Name</label>
                                    <input type="text" name="RoleName" id="a-fullname" class="form-input-field border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1" placeholder="e.g., Content Manager" required>
                                </div>
                                <div class="d-flex align-items-start flex-column w-100 my-2">
                                    <label formlabel="Email">Description</label>
                                    <textarea id="a-product-description" name="Description"
                                              class="w-100 border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1 rounded-10"
                                              placeholder="Describe the purpose of this role..."
                                              style="height:60px; resize:none; outline:none;"></textarea>
                                </div>
                                <div class="d-flex align-items-start flex-column w-100 my-2">
                                    <label formlabel="Permission">Permission</label>
                                    <div class="border rounded-10 w-100 p-3 overflow-y-auto" style="height:500px;">
                                        <script>
                                            var permissions = @Html.Raw(Json.Serialize(ViewBag.rolePermissionLookup));

                                            console.log(permissions);
                                        </script>


                                        
                                        <ul class="overflow-y-auto">
                                            @foreach (var module in ViewBag.rolePermissionLookup)
                                            {
                                                <li>
                                                    <strong>@module.Key</strong>

                                                    <ul>
                                                        @foreach (var permission in module.Value)
                                                        {
                                                            var permissionId = permission.ToLower()
                                                            .Replace(" ", "-");

                                                            <li>
                                                                <input type="checkbox"
                                                                       id="@permissionId"
                                                                       name="Permission"
                                                                       value="@permission">

                                                                <label for="@permissionId">
                                                                    @permission
                                                                </label>
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">
                                <span>Close</span>
                            </button>
                            <button type="submit" class="btn btn-dark rounded-2 d-flex">
                                <span>Create Role</span>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    @* Total Summary *@
    <div class="row d-flex justify-content-center">
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Total Roles</p>
                <i class="bi bi-shield h5 p-2 rounded-10 text-primary bg-primary bg-opacity-10"></i>
            </div>
            <h3>@ViewBag.TotalRoles</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>High Access</p>
                <i class="bi bi-shield-check h5 p-2 rounded-10 bg-red-100 text-red-600"></i>
            </div>
            <h3>@ViewBag.TotalHightAccess</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Medium Access</p>
                <i class="bi bi-shield-exclamation h5 p-2 rounded-10 bg-yellow-100 text-yellow-600"></i>
            </div>
            <h3>@ViewBag.TotalMediumAccess</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Total Users</p>
                <i class="bi bi-people h5 p-2 rounded-10 bg-green-100 text-green-700"></i>
            </div>
            <h3>@ViewBag.TotalUsers</h3>
        </div>
    </div>


    @* Search by name or descritption *@
    <form method="get" asp-action="Index">
        <div class="w-100 bg-white mt-3 rounded-10 p-4 shadow-sm d-flex justify-content-between border">
            <i class="bi bi-search position-absolute text-secondary mt-2 ms-3"></i>
            <input type="search" name="searchItem"
                   class="w-100 p-2 border-0 bg-light rounded-10 focus-ring form-search ps-5"
                   placeholder="Search roles by name or description..." />
            
        </div>

    </form>

    @* Role List *@
    <div class="mt-4 rounded-15">
        <div class="table-responsive rounded-15">
            <table id="roleTable" class="table bg-white shadow-sm table-hover rounded-15 border">
                <thead class="table-light">
                    <tr>
                        <th class="p-4 fw-normal">Role Name</th>
                        <th class="p-4 fw-normal">Description</th>
                        <th class="p-4 fw-normal">Access Level</th>
                        <th class="p-4 fw-normal">Permissions</th>
                        <th class="p-4 fw-normal">Users</th>
                        <th class="p-4 fw-normal">Created</th>
                        <th class="p-4 fw-normal text-center">Actions</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var role in Model.Items)
                    {
                        <tr>
                            @* RoleName *@
                            <td class="pt-4 ps-4 fw-semibold">
                                <p class="visually-hidden data-id">@role.Id</p>
                                <script>
                                     @{
                                                    string roleClass = role.RoleName switch
                                                {
                                                             "Admin" => "bg-red-100 text-red-600",
                                                            "Manager" => "bg-yellow-100 text-yellow-600",
                                                                    _ => "bg-green-100 text-green-700"
                                                };
                                                            string iconRole = role.RoleName switch
                                                    {
                                                                    "Admin" => "bi bi-shield-check",
                                                                    "Manager" => "bi bi-shield-exclamation",
                                                                    _ => "bi bi-shield"
                                                    };
                                    }
                                </script>
                                

                                <div>
                                    <i class="@iconRole p-2 rounded-10 @roleClass data-role"></i>
                                    <span class="ms-2 data-fullname">@role.RoleName</span><br />
                                </div>
                            </td>

                            @* Description *@
                            <td class="pt-4 ps-3">
                                <span class="ms-2 data-description">@role.Description</span><br />
@*      
                            *@
                               
                            </td>

                            @* acess *@
                            <td class="pt-4 ps-3">
                                <script>
                                    @{
                                    string accessLevelClass = role.AccessLevel switch
                                                {
                                                             "High" => "bg-red-100 text-red-600",
                                                            "Medium" => "bg-yellow-100 text-yellow-600",
                                                                    _ => "bg-green-100 text-green-700"
                                                };
                                    }
                                </script>
                                <span class="@accessLevelClass badge data-access-level px-2 py-1 rounded-10 border small">
                                    @role.AccessLevel
                                </span>
                            </td>
                            @* permission *@
                            <td class="pt-4 ps-3">
                                <span class=" data-permission-count text-secondary px-2 py-1 rounded-10">
                                    <i class="bi bi-lock "></i>
                                    @role.Permission.Count
                                </span>

                               

                                <span class="data-permissions" hidden>
                                    @string.Join(",", @role.Permission)
                                </span>

                            </td>

                            @* Total user *@
                            <td class="pt-4 ps-4 data-user-count">
                                <i class="bi bi-people"></i>
                                @role.Users
                             </td>

                            @* created date *@
                            <td class="pt-4 ps-4 data-joindate">@role.Created</td>
                            <td class="text-center pt-4 position-relative">

                                @* Action dropdown *@

                                <div class="dropdown">

                                    <a class="btn border-0" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical p-2 rounded-10"></i>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-rigth" aria-labelledby="dropdownMenuLink">
                                        <a class="dropdown-header small fw-bold" href="#">Action</a>
                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item small rounded-10 action-button view" data-toggle="modal" data-target="#viewDetail">
                                            <i class="bi bi-eye"></i>
                                            <span class="ms-2">View Details</span>
                                        </button>
                                        <button class="dropdown-item small rounded-10 action-button" data-toggle="modal" data-target="#edit">
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="ms-2"> Edit Role</span>
                                        </button>

                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item small rounded-10 action-button btn-edit-role" data-toggle="modal" data-target="#delete" href="#"
                                        data-permissions='@Html.Raw(Json.Serialize(role.Permission))'>
                                            <i class="bi bi-trash3"></i>
                                            <span class="text-danger ms-2">Delete Role</span>
                                        </button>
                                    </div>



                                    <!-- ViewDetail Modal -->
                                    <!-- View Detail Modal -->
                                    
                                    <div class="modal fade"
                                         id="viewDetail"
                                         tabindex="-1"
                                         role="dialog"
                                         aria-labelledby="viewDetailLabel"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered"
                                             style="max-width:50%; margin:auto;"
                                             >

                                            <div class="modal-content">

                                                <!-- Header -->
                                                <div class="modal-header flex-column align-items-start mx-2">

                                                    <h5 class="modal-title fw-semibold" id="viewDetailLabel">
                                                        Role Details
                                                    </h5>

                                                    <p class="text-muted mb-0">
                                                        Complete information about this role and its permissions
                                                    </p>

                                                    <button type="button"
                                                            class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white"
                                                            data-dismiss="modal"
                                                            aria-label="Close">

                                                        <span aria-hidden="true" class="fs-5">&times;</span>

                                                    </button>

                                                </div>


                                                <!-- Body -->
                                                <div class="modal-body mx-2">

                                                    <!-- Role Header -->
                                                    <div class="d-flex align-items-center gap-3">

                                                        <!-- Icon -->
                                                        <div class="custom-gradient rounded-3
                                                                    d-flex justify-content-center
                                                                    align-items-center flex-shrink-0"
                                                             style="width:50px;height:50px;">

                                                            <i class="bi bi-shield-lock text-danger fs-4"></i>

                                                        </div>


                                                        <!-- Role Information -->
                                                        <div class="d-flex flex-column">

                                                            <h4 class="fw-semibold mb-1"
                                                                id="v-fullname">
                                                                -
                                                            </h4>

                                                            <p class="text-secondary mb-0"
                                                               id="v-role-detail">
                                                                -
                                                            </p>

                                                        </div>


                                                        <!-- Access Badge -->
                                                        <div class="ms-auto">

                                                            <span class="badge rounded-pill
                                         px-4 py-2 fs-6"
                                                                  id="v-access-level">
                                                                -
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="border-top w-100 mt-3"></div>


                                                    <!-- Statistics -->
                                                    <div class="mt-3">

                                                        <div class="row g-3">

                                                            <!-- Permissions -->
                                                            <div class="col-md-4">

                                                                <div class="bg-light rounded-3 p-3 role-stat-card">

                                                                    <div class="text-secondary mb-2">
                                                                        Permissions
                                                                    </div>

                                                                    <div class="fs-3"
                                                                         id="v-permission-count">
                                                                        0
                                                                    </div>

                                                                </div>

                                                            </div>


                                                            <!-- Users -->
                                                            <div class="col-md-4">

                                                                <div class="bg-light rounded-3 p-3 role-stat-card">

                                                                    <div class="text-secondary mb-2">
                                                                        Users
                                                                    </div>

                                                                    <div class="fs-3"
                                                                         id="v-user-count">
                                                                        0
                                                                    </div>

                                                                </div>

                                                            </div>


                                                            <!-- Created -->
                                                            <div class="col-md-4">

                                                                <div class="bg-light rounded-3 p-3 role-stat-card">

                                                                    <div class="text-secondary mb-2">
                                                                        Created
                                                                    </div>

                                                                    <div id="v-role-create">
                                                                        -
                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>


                                                        <!-- Permissions -->
                                                        <div class="mt-4">

                                                            <div class="d-flex align-items-start">
                                                                <h5 class="fw-semibold mb-3 ">
                                                                    Assigned Permissions
                                                                </h5>
                                                            </div>

                                                            <!-- JavaScript inserts permissions here -->
                                                            <div id="v-permissions">
                                                                <script>
                                                                    $(document).ready(function () {

                                                                        $(document).on("click", ".view", function (e) {

                                                                            e.preventDefault();

                                                                            var row = $(this).closest("tr");

                                                                            // ==========================
                                                                            // Get Role ID
                                                                            // ==========================

                                                                            var roleId = row.find(".data-id")
                                                                                .text()
                                                                                .trim()
                                                                                .replace("#", "");

                                                                            console.log("Role ID:", roleId);


                                                                            // ==========================
                                                                            // Call API
                                                                            // ==========================

                                                                            $.ajax({

                                                                                url: '/RoleManagement/GetById',

                                                                                type: 'POST',

                                                                                data: {
                                                                                    roleId: roleId
                                                                                },


                                                                                success: function (res) {

                                                                                    console.log("Role response:", res);


                                                                                    if (!res || !res.data) {

                                                                                        alert("Role not found.");

                                                                                        return;
                                                                                    }


                                                                                    // ==========================
                                                                                    // Get Role
                                                                                    // ==========================

                                                                                    var role = Array.isArray(res.data)
                                                                                        ? res.data[0]
                                                                                        : res.data;


                                                                                    if (!role) {

                                                                                        alert("Role not found.");

                                                                                        return;
                                                                                    }


                                                                                    // ==========================
                                                                                    // Read Properties
                                                                                    // ==========================

                                                                                    var roleName =
                                                                                        role.Name ??
                                                                                        role.name ??
                                                                                        "";


                                                                                    var description =
                                                                                        role.description ??
                                                                                        role.Description ??
                                                                                        "No description";


                                                                                    var permissions =
                                                                                        role.permissions ??
                                                                                        role.Permission ??
                                                                                        role.permission ??
                                                                                        [];


                                                                                    var userCount =
                                                                                        role.userCount ??
                                                                                        role.UserCount ??
                                                                                        role.users ??
                                                                                        role.Users ??
                                                                                        0;


                                                                                    var createdDate =
                                                                                        role.createdAt ??
                                                                                        role.CreatedAt ??
                                                                                        role.created ??
                                                                                        role.Created ??
                                                                                        "";


                                                                                    var id =
                                                                                        role.id ??
                                                                                        role.Id ??
                                                                                        roleId;


                                                                                    // Make sure permissions is an array
                                                                                    if (!Array.isArray(permissions)) {

                                                                                        permissions = [];

                                                                                    }


                                                                                    // ==========================
                                                                                    // Permission Count
                                                                                    // ==========================

                                                                                    var permissionCount = permissions.length;


                                                                                    // ==========================
                                                                                    // Role Information
                                                                                    // ==========================

                                                                                    $("#v-fullname").text(roleName);

                                                                                    $("#v-role-detail").text(description);

                                                                                    $("#v-permission-count").text(permissionCount);

                                                                                    $("#v-user-count").text(userCount);

                                                                                    $("#v-role-create").text(createdDate);

                                                                                    $("#v-id").text("#" + id);


                                                                                    // ==========================
                                                                                    // Access Level
                                                                                    // ==========================

                                                                                    var accessLevel = "No Access";

                                                                                    var accessClass =
                                                                                        "bg-secondary-subtle text-secondary";


                                                                                    if (permissionCount >= 15) {

                                                                                        accessLevel = "High Access";

                                                                                        accessClass =
                                                                                            "bg-danger-subtle text-danger";

                                                                                    }
                                                                                    else if (permissionCount >= 8) {

                                                                                        accessLevel = "Medium Access";

                                                                                        accessClass =
                                                                                            "bg-warning-subtle text-warning";

                                                                                    }
                                                                                    else if (permissionCount > 0) {

                                                                                        accessLevel = "Low Access";

                                                                                        accessClass =
                                                                                            "bg-primary-subtle text-primary";

                                                                                    }


                                                                                    $("#v-access-level")
                                                                                        .removeClass()
                                                                                        .addClass(
                                                                                            "badge rounded-pill px-4 py-2 fs-6 " +
                                                                                            accessClass
                                                                                        )
                                                                                        .text(accessLevel);


                                                                                    // ==========================
                                                                                    // Group Permissions
                                                                                    // ==========================

                                                                                    var groupedPermissions = {};


                                                                                    $.each(permissions, function (index, permission) {

                                                                                        if (!permission) {
                                                                                            return;
                                                                                        }


                                                                                        var parts = permission.split("::");

                                                                                        var module = parts[0] || "";

                                                                                        var action = parts[1] || "";


                                                                                        if (!groupedPermissions[module]) {

                                                                                            groupedPermissions[module] = [];

                                                                                        }


                                                                                        groupedPermissions[module].push(action);

                                                                                    });


                                                                                    // ==========================
                                                                                    // Build Permission HTML
                                                                                    // ==========================

                                                                                    var permissionHtml = "";


                                                                                    $.each(
                                                                                        groupedPermissions,
                                                                                        function (module, actions) {

                                                                                            permissionHtml += `

                                                                                                <div class="border rounded-3 p-3 mb-3">

                                                                                                    <div class="d-flex align-items-start">
                                                                                                        <h5 class="mb-3">
                                                                                                            ${escapeHtml(module)}
                                                                                                        </h5>
                                                                                                    </div>

                                                                                                    <div class="row">

                                                                                            `;


                                                                                            $.each(actions, function (index, action) {

                                                                                                var permissionName = "";


                                                                                                switch (action.toLowerCase()) {

                                                                                                    case "read":

                                                                                                        permissionName =
                                                                                                            `View ${module}`;

                                                                                                        break;


                                                                                                    case "create":

                                                                                                        permissionName =
                                                                                                            `Create ${module}`;

                                                                                                        break;


                                                                                                    case "update":

                                                                                                        permissionName =
                                                                                                            `Edit ${module}`;

                                                                                                        break;


                                                                                                    case "delete":

                                                                                                        permissionName =
                                                                                                            `Delete ${module}`;

                                                                                                        break;


                                                                                                    default:

                                                                                                        permissionName = action;

                                                                                                        break;

                                                                                                }


                                                                                                permissionHtml += `

                                                                                                    <div class="col-md-6">

                                                                                                        <div class="d-flex align-items-center mb-2">

                                                                                                            <span class="me-2"
                                                                                                                  style="
                                                                                                                    width:7px;
                                                                                                                    height:7px;
                                                                                                                    background:#0d6efd;
                                                                                                                    border-radius:50%;
                                                                                                                    display:inline-block;
                                                                                                                  ">
                                                                                                            </span>

                                                                                                            <span class="text-secondary ">

                                                                                                                ${escapeHtml(permissionName)}

                                                                                                            </span>

                                                                                                        </div>

                                                                                                    </div>

                                                                                                `;

                                                                                            });


                                                                                            permissionHtml += `

                                                                                                    </div>

                                                                                                </div>

                                                                                            `;

                                                                                        }
                                                                                    );


                                                                                    // ==========================
                                                                                    // No Permissions
                                                                                    // ==========================

                                                                                    if (permissionHtml === "") {

                                                                                        permissionHtml = `

                                                                                            <div class="border rounded-3 p-3">

                                                                                                <span class="text-secondary">

                                                                                                    No permissions assigned.

                                                                                                </span>

                                                                                            </div>

                                                                                        `;

                                                                                    }


                                                                                    // ==========================
                                                                                    // Display Permissions
                                                                                    // ==========================

                                                                                    $("#v-permissions").html(permissionHtml);


                                                                                    // ==========================
                                                                                    // Save ID for Edit
                                                                                    // ==========================

                                                                                    $("#view-edit-role")
                                                                                        .data("role-id", id);


                                                                                    // ==========================
                                                                                    // Open Modal
                                                                                    // ==========================

                                                                                    // $("#viewDetail").modal("show");

                                                                                },


                                                                                error: function (xhr) {

                                                                                    console.error(
                                                                                        "Get role detail failed:",
                                                                                        xhr.responseText
                                                                                    );

                                                                                    alert("Get role detail failed.");

                                                                                }

                                                                            });

                                                                        });




                                                                        // ==========================
                                                                        // HTML Escape
                                                                        // ==========================

                                                                        function escapeHtml(value) {

                                                                            if (value === null || value === undefined) {

                                                                                return "";

                                                                            }


                                                                            return String(value)
                                                                                .replace(/&/g, "&amp;")
                                                                                .replace(/</g, "&lt;")
                                                                                .replace(/>/g, "&gt;")
                                                                                .replace(/"/g, "&quot;")
                                                                                .replace(/'/g, "&#039;");

                                                                        }

                                                                    });
                                                                </script>
                                                            </div>

                                                        </div>

                                                    </div>


                                                    <div class="border-top w-100 mt-3"></div>


                                                    <!-- Role ID -->
                                                    <div class="d-flex flex-column align-items-start my-3">

                                                        <p class="mb-1">
                                                            Role Id
                                                        </p>

                                                        <div id="v-id">
                                                            -
                                                        </div>

                                                    </div>

                                                </div>


                                                <!-- Footer -->
                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn border bg-white rounded-2"
                                                            data-dismiss="modal">

                                                        Close

                                                    </button>


                                                    <button type="button"
                                                            data-toggle="modal"
                                                            data-dismiss="modal"
                                                            data-target="#edit"
                                                            class="btn btn-dark rounded-2 d-flex">

                                                        <i class="bi bi-pencil-square"></i>

                                                        <span class="ms-3">
                                                            Edit Role
                                                        </span>

                                                    </button>

                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                    <!-- Delete Modal -->
                                    <form id="delete-role">
                                        <div class="modal fade" id="delete" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="exampleModalLongTitle">Delete Role</h5>
                                                        <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                                            <span aria-hidden="true" class="fs-5">&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="border-top w-100 "></div>
                                                    <div class="modal-body d-flex flex-column align-items-start mx-2">
                                                        <input type="text" name="Id" id="d-id" hidden>
                                                        You sure you want to delete this role
                                                        <span id="d-fullname"></span>
                                                    </div>
                                                    <div class="border-top w-100 "></div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">No</button>
                                                        <button type="submit" class="btn btn-danger rounded-2">Yes</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </form>


                                    <!-- Edit Modal -->
                                    <div class="modal fade" id="edit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" style="max-width:50%; margin:auto;" role="document">
                                            <div class="modal-content">
                                                <form id="edit-role-permission">
                                                    @Html.AntiForgeryToken()

                                                    <div class="modal-header flex-column align-items-start mx-2">
                                                        <h5 class="modal-title fw-semibold" id="exampleModalLabel">
                                                            Edit Role
                                                        </h5>
                                                        <p class="text-muted mb-0">Update role information and permissions.</p>
                                                        <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                                            <span aria-hidden="true" class="fs-5">&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body mx-2" style="max-height:60vh; overflow-y:auto;">
                                                        <div class="d-flex align-items-start flex-column justify-content-between">
                                                            <div class="d-flex align-items-start flex-column w-100 mb-2">

                                                                <label formlabel="Full Name">Role Name</label>
                                                                <input hidden type="text" name="Id" id="edit-id" class="form-input-field border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1" placeholder="e.g., Content Manager" required>
                                                                <input type="text" name="RoleName" id="edit-fullname" class="form-input-field border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1" placeholder="e.g., Content Manager" required>
                                                            </div>
                                                            <div class="d-flex align-items-start flex-column w-100 my-2">
                                                                <label formlabel="Email">Description</label>
                                                                <textarea id="edit-description" name="Description"
                                                                      class="w-100 border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1 rounded-10"
                                                                      placeholder="Describe the purpose of this role..."
                                                                      style="height:60px; resize:none; outline:none;"></textarea>
                                                            </div>
                                                            <div class="d-flex align-items-start flex-column w-100 my-2">
                                                                <label formlabel="Permission">Permission</label>
                                                                <div class="border rounded-10 w-100 p-3 overflow-y-auto" style="height:500px;">
                                                                    <script>
                                                                        var permissions = @Html.Raw(Json.Serialize(ViewBag.rolePermissionLookup));

                                                                        console.log(permissions);
                                                                    </script>



                                                                    <ul class="list-unstyled mb-0">
                                                                        @foreach (var module in ViewBag.rolePermissionLookup)
                                                                        {
                                                                            <li class="mb-3">
                                                                                <div class="d-flex align-items-center">
                                                                                    <strong>@module.Key</strong>
                                                                                </div>

                                                                                <ul class="list-unstyled mt-2">
                                                                                    @foreach (var permission in module.Value)
                                                                                    {
                                                                                       

                                                                                        var permissionValue = permission.Replace(" ","::");

                                                                                        var permissionId = permissionValue
                                                                                        .ToLower()
                                                                                        .Replace("::", "-")
                                                                                        .Replace(" ", "-");

                                                                                        <li class="mb-2">
                                                                                            <div class="d-flex align-items-center">
                                                                                                <input type="checkbox"
                                                                                                       id="@permissionId"
                                                                                                       name= "Permission"
                                                                                                       value="@permissionValue"
                                                                                                       class="form-check-input me-2">

                                                                                                <label for="@permissionId" class="mb-0">
                                                                                                    @permission
                                                                                                </label>
                                                                                            </div>
                                                                                        </li>
                                                                                    }
                                                                                </ul>
                                                                            </li>
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">
                                                            <span>Close</span>
                                                        </button>
                                                        <button type="submit" class="btn btn-dark rounded-2 d-flex">
                                                            <span>Save Changes</span>
                                                        </button>
                                                    </div>
                                                </form>

                                            </div>
                                        </div>
                                    </div>


                                </div>


                            </td>
                        </tr>
                    }

                    <tr>
                        <td colspan="5" class="pt-4 ps-4 small text-secondary border-0">
                            @{
                                var start = 0;
                                var end = 0;
                                if (Model.TotalCount != 0)
                                {
                                    start = (Model.PageNumber - 1) * Model.PageSize + 1;
                                    end = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
                                }
                            }
                            <p hidden id="data-page-number">@Model.PageNumber</p>
                            <p hidden id="data-total-count">@Model.TotalCount</p>
                            Showing @start to @end of @Model.TotalCount roles
                        </td>
                        <td class="p-3 border-0 text-end">
                            <a class="btn btn-sm rounded-10 py-2 px-3 border
                                @(Model.PageNumber == 1 ? "disabled" : "")"
                               asp-page="/UserManagement/Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)">
                                Previous
                            </a>
                        </td>
                        <td class="p-3 border-0 text-start">
                            <a class="btn btn-sm rounded-10 py-2 px-3 border @(Model.PageNumber* Model.PageSize >= Model.TotalCount ? "disabled" : "")"
                               asp-page="/UserManagement/Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)">
                                Next
                            </a>
                        </td>
                    </tr>

                </tbody>

            </table>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {

        $(".action-button").click(function () {
            var row = $(this).closest("tr");


            var id = row.find(".data-id").text().trim();

            var initial = row.find(".data-initial").text().trim();
            var name   = row.find(".data-fullname").text().trim();
            var email  = row.find(".data-email").text().trim();
            var status = row.find(".data-status").text().trim();
            var role   = row.find(".data-role").text().trim();
            var lastactive = row.find(".data-lastactive").text().trim();
            var joindate = row.find(".data-joindate").text().trim();
            var description = row.find(".data-description").text().trim();
            var permissionsText = row.find(".data-permissions").text().trim();
            var userCount = row.find(".data-user-count").text().trim();
            var permissionCount = row.find(".data-permission-count").text().trim();
            var accessLevel = row.find(".data-access-level").text().trim();

            var permissions = permissionsText
                .split(",")
                .map(p => p.trim())
                .filter(p => p !== "");





            $("#id").val(id);
            $("#initial").val(initial);
            $("#fullname").val(name);
            $("#email").val(email);
            $("#status").val(status);
            $("#status").removeClass();
            @* $("#status").addClass("rounded-pill px-2 py-1"); *@
            $("#role").val(role);
            $("#role").removeClass();

            $("#v-id").text(id);
            $("#v-fullname").text(name);
            $("#v-role-detail").text(description);
            $("#v-email").text(email);
            $("#v-user-count").text(userCount);
            $("#v-permission-count").text(permissionCount);
            $("#v-access-level").text(accessLevel);
            $("#v-role-create").text(joindate);

            $("#v-status").text(status);

                if (status === "Active") {
                    $("#v-status").addClass(" rounded-pill px-2 py-1 bg-green-100 text-green-700");
                }
                else if (status === "InActive") {
                    $("#v-status").addClass("rounded-pill px-2 py-1 bg-gray-100 text-gray-700");
                }
                else {
                    $("#v-status").addClass(" rounded-pill px-2 py-1 bg-red-100 text-red-700");
                }

                if (role === "Admin") {
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-purple-100 text-purple-700");
                }
                else if (role === "Manager") {
                    $("#v-role").addClass("rounded-pill px-2 py-1 bg-blue-100 text-blue-700");
                }
                else if (role === "Staff"){
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-green-100 text-green-700");
                }else if (role === "Support"){
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-orange-100 text-orange-700");
                }
                else{
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-gray-100 text-gray-700");
                }

            $("#v-role").text(role);
            $("#v-lastactive").text(lastactive);
            $("#v-joindate").text(joindate);
            $("#v-id").text(id);
            

            $("#d-fullname").text(name);
            $("#d-id").val(id);

            @* edit action *@
            $("#edit-fullname").val(name);
            $("#edit-description").val(description);
            $("#edit-id").val(id);


            // Clear all checkboxes first
             $("input[name='Permission']").prop("checked", false); 
                     

            // Check permissions belonging to this role
            permissions.forEach(function (permission) {

                $("input[name='Permission']").filter(function () {
                    return $(this).val().trim().toUpperCase() === permission.trim().toUpperCase();
                }).prop("checked", true);

            });

        });      

    });
  

</script>


<script>
    $(document).ready(function () {

        $('#edit-role-permission').submit(function (e) {
            e.preventDefault();
            var formData = $("#edit-role-permission").serialize();

            console.log(formData);

            $.ajax({
                url: '/RoleManagement/Update',
                type: 'POST',
                data: $('#edit-role-permission').serialize(),


                success: function (response) {
                    alert(response.message);
                    location.reload();
                },

                error: function (xhr) {
                    alert("Update failed");
                }
            });

        });

        @* Add Role *@
        $('#add-role-permission').submit(function (e) {
        e.preventDefault();


        var form = $('#add-role-permission');

        $.ajax({
            url: '/RoleManagement/Create',
            type: 'POST',
            data: form.serialize(),
            headers: {
                'RequestVerificationToken':
                    $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                alert(response.message);
                location.reload();
            },
            error: function (xhr) {
                console.log(xhr.responseText);
                alert("Create failed");
            }
        });
    });

        $('#delete-role').submit(function (e){
            e.preventDefault();

            $.ajax({
                url: '/RoleManagement/Delete',
                type: 'POST',
                data: $('#d-id').serialize(),

                success: function (response){
                    alert(response.message);
                    location.reload();
                },
                error: function (xhr) {
                    alert("Delete failed");
                }
            });
        });
       

        $('#export-role').on('submit', function (e) {
            e.preventDefault();

            var pageNumber = $("#data-page-number").text().trim();
            var count = $("#data-total-count").text().trim();

            var url = `/RoleManagement/Export?pageNumber=${pageNumber}&count=${count}`;

            window.open(url, '_blank'); // better for download behavior
        });

    });
</script>