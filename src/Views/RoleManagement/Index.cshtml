<!-- View (Index.cshtml) -->
@using System.ComponentModel.Design
@using src.Enums
@model src.Extensions.Pagenations.PagedResult<src.DTO.UserDto.UserResponseDto>

@if (TempData["Message"] != null)
{
    <div>@TempData["Message"]</div>
}

<style>
    :root {
        --primary-bg-color: linear-gradient(to bottom right, #10b981 0%, #14b8a6 50%, #0891b2 100%);
        --text-gray: #9ca3af;
    }

    p {
        color: #6c757d;
    }

    .bi-three-dots-vertical:hover {
        background-color: #f3f4f6;
    }

    .form-search:focus {
        outline: none; /* Remove default outline */

        box-shadow: 0 0 0 3px lightgray; /* Add a custom "ring" using box-shadow */
    }

    .shadow-sm {
        box-shadow: 1px 1px 1px 1px rgba(0, 0, 0, 0.3);
    }

    .custom-gradient {
        background: linear-gradient(to bottom right, #3b82f6, #8b5cf6);
        color: white;
    }

    .modal-header,
    .modal-footer {
        border: none !important;
    }

    .form-input {
        color: var(--text-gray);
    }

    .form-input-field {
        width: 100%;
        border-radius: 10px;
    }
</style>
<div class="">
    <div class="d-flex justify-content-between">
        @* heading *@
        <div>
            <h3>Role Management</h3>
            <p>Manage roles and permissions for your admin system</p>
        </div>

        @* add user *@

        <div>
            <form id="export-product" method="post" class="gap-2">
                <button type="submit" class="btn border rounded-10">
                    <i class="bi bi-download"></i>
                    <span class="fw-light">Export</span>
                </button>
                <button type="button" class="btn btn-primary rounded-10" role="button" data-toggle="modal" data-target="#AddRole">
                    <i class="bi bi-plus-lg"></i>
                    <span class="fw-light">Add Role</span>
                </button>
            </form>
        </div>

        <!-- add user Modal -->
        <div class="modal fade" id="AddRole" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" style="max-width:50%; margin:auto;" role="document">
                <div class="modal-content">
                    <form id="add-user">
                        @Html.AntiForgeryToken()

                        <div class="modal-header flex-column align-items-start mx-2">
                            <h5 class="modal-title fw-semibold" id="exampleModalLabel">
                                Add New Role
                            </h5>
                            <p class="text-muted mb-0">Create a new role with specific permissions.</p>
                            <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true" class="fs-5">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body mx-2" style="max-height:60vh; overflow-y:auto;">
                            <div class="d-flex align-items-start flex-column justify-content-between">
                                <div class="d-flex align-items-start flex-column w-100 mb-2">

                                    <label formlabel="Full Name">Role Name</label>
                                    <input type="text" name="FullName" id="a-fullname" class="form-input-field border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1" placeholder="e.g., Content Manager" required>
                                </div>
                                <div class="d-flex align-items-start flex-column w-100 my-2">
                                    <label formlabel="Email">Description</label>
                                    <textarea id="a-product-description" name="Description"
                                              class="w-100 border-0 p-1 ps-3 pb-2 shadow-none bg-light my-1 rounded-10"
                                              placeholder="Describe the purpose of this role..."
                                              style="height:60px; resize:none; outline:none;"></textarea>
                                </div>
                                <div class="d-flex align-items-start flex-column w-100 my-2">
                                    <label formlabel="Permission">Permission</label>
                                    <div class="border rounded-10 w-100 p-3 overflow-y-auto" style="height:500px;">

                                        <ul class="overflow-y-auto">
                                            <li>Dashboard</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-dashboard" name="viewDashboard" value="viewDashboard">
                                                    <label for="ViewDashboard"> View Dashboard</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="view-analytic" name="viewAnalytic" value="viewAnalytic">
                                                    <label for="ViewAnalytic"> View Analytics</label><br>
                                                </li>
                                            </ul>
                                        </ul>
                                        <ul>
                                            <li>Products</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-product" name="viewProduct" value="viewProduct">
                                                    <label for="ViewProduct"> View Products</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="create-product" name="createProduct" value="createProduct">
                                                    <label for="CreateProduct"> Create Products</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="edit-product" name="editProduct" value="editProduct">
                                                    <label for="EditProduct"> Edit Products</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="delete-product" name="deleteProduct" value="deleteProduct">
                                                    <label for="DeleteProduct"> Delete Products</label><br>
                                                </li>
                                            </ul>
                                        </ul>
                                        <ul>
                                            <li>Orders</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-order" name="viewOrder" value="viewOrder">
                                                    <label for="ViewOrder"> View Orders</label><br>
                                                </li>
                                         
                                                <li>
                                                    <input type="checkbox" id="edit-order" name="editOrder" value="editOrder">
                                                    <label for="EditOrder"> Edit Orders</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="delete-order" name="deleteOrder" value="deleteOrder">
                                                    <label for="DeleteOrder"> Delete Orders</label><br>
                                                </li>
                                            </ul>
                                        </ul >
                                        <ul>
                                            <li>Customers</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-customer" name="viewCustomer" value="viewCustomer">
                                                    <label for="ViewCustomer"> View Customers</label><br>
                                                </li>
                                         
                                                <li>
                                                    <input type="checkbox" id="edit-customer" name="editCustomer" value="editCustomer">
                                                    <label for="EditCustomer"> Edit Customers</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="delete-customer" name="deleteCustomer" value="deleteCustomer">
                                                    <label for="DeleteCustomer"> Delete Customers</label><br>
                                                </li>
                                            </ul>
                                        </ul>
                                        <ul>
                                            <li>User Management</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-user" name="viewUser" value="viewUser">
                                                    <label for="ViewUser"> View Users</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="create-user" name="createUser" value="createUser">
                                                    <label for="CreateUser"> Create Users</label><br>
                                                </li>
                                         
                                                <li>
                                                    <input type="checkbox" id="edit-user" name="editUser" value="editUser">
                                                    <label for="EditUser"> Edit Users</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="delete-user" name="deleteUser" value="deleteUser">
                                                    <label for="DeleteUser"> Delete Users</label><br>
                                                </li>
                                            </ul>
                                        </ul>
                                        <ul>
                                            <li>Role Management</li>
                                            <ul>
                                                <li>
                                                    <input type="checkbox" id="view-role" name="viewRole" value="viewRole">
                                                    <label for="ViewRole"> View Roles</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="create-role" name="createRole" value="createRole">
                                                    <label for="CreateRole"> Create Roles</label><br>
                                                </li>
                                         
                                                <li>
                                                    <input type="checkbox" id="edit-role" name="editRole" value="editRole">
                                                    <label for="EditRole"> Edit Roles</label><br>
                                                </li>
                                                <li>
                                                    <input type="checkbox" id="delete-role" name="deleteRole" value="deleteRole">
                                                    <label for="DeleteRole"> Delete Roles</label><br>
                                                </li>
                                            </ul>
                                        </ul>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">
                                <span>Close</span>
                            </button>
                            <button type="submit" class="btn btn-dark rounded-2 d-flex">
                                <span>Create Role</span>
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <div class="row d-flex justify-content-center">
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Total Roles</p>
                <i class="bi bi-shield h5 p-2 rounded-10 text-primary bg-primary bg-opacity-10"></i>
            </div>
            <h3>@ViewBag.Total</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>High Access</p>
                <i class="bi bi-shield-check h5 p-2 rounded-10 bg-red-100 text-red-600"></i>
            </div>
            <h3>@ViewBag.ActiveStatuses</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Medium Access</p>
                <i class="bi bi-shield-exclamation h5 p-2 rounded-10 bg-yellow-100 text-yellow-600"></i>
            </div>
            <h3>@ViewBag.InActiveStatuses</h3>
        </div>
        <div class="col m-3 rounded-10 p-4 bg-white shadow-sm border">
            <div class="d-flex text-secondary justify-content-between">
                <p>Total Users</p>
                <i class="bi bi-people h5 p-2 rounded-10 bg-green-100 text-green-700"></i>
            </div>
            <h3>@ViewBag.SuspendedStatuses</h3>
        </div>
    </div>


    <form method="get" asp-action="Index">
        <div class="w-100 bg-white mt-3 rounded-10 p-4 shadow-sm d-flex justify-content-between border">
            <i class="bi bi-search position-absolute text-secondary mt-2 ms-3"></i>
            <input type="search" name="searchItem"
                   class="w-100 p-2 border-0 bg-light rounded-10 focus-ring form-search ps-5"
                   placeholder="Search roles by name or description..." />
            
        </div>

    </form>


    <div class="mt-4 rounded-15">
        <div class="table-responsive rounded-15">
            <table id="userTable" class="table bg-white shadow-sm table-hover rounded-15 border">
                <thead class="table-light">
                    <tr>
                        <th class="p-4 fw-normal">Role Name</th>
                        <th class="p-4 fw-normal">Description</th>
                        <th class="p-4 fw-normal">Access Level</th>
                        <th class="p-4 fw-normal">Permissions</th>
                        <th class="p-4 fw-normal">Users</th>
                        <th class="p-4 fw-normal">Created</th>
                        <th class="p-4 fw-normal text-center">Actions</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td class="pt-4 ps-4 fw-semibold d-flex">
                                <p class="visually-hidden data-id">@user.Id</p>
                                <div class="custom-gradient rounded-circle border w-30px h-30px bg-light d-flex justify-content-center pt-1 border-0">
                                    @{
                                        var names = user.FullName.Split(' ');
                                        var initials = names.Length > 1
                                        ? $"{names[0][0]}{names[1][0]}"
                                        : $"{names[0][0]}";
                                    }
                                    <h6 class="d-flex justify-content-center align-items-center data-initial">@initials</h6>
                                </div>
                                <div>
                                    <span class="ms-2 data-fullname">@user.FullName</span><br />
                                    <p class="ms-2 data-email">@user.Email</p>
                                </div>
                            </td>
                            <td class="pt-4 ps-3">
                                <script>
                                    @{
                                            var badgeColor = user.Status == "Active" ? "bg-green-100 text-green-700" : user.Status == "InActive" ? "bg-gray-100 text-gray-700" : "bg-red-100 text-red-700";
                                            var iconStatus = user.Status == "Active" ? "bi bi-check2-circle" : user.Status == "InActive" ? "bi bi-clock" : "bi bi-x-circle";
                                    }
                                </script>
                                <span class="badge @badgeColor px-3 py-2 rounded-pill small data-status">
                                    <i class="@iconStatus"></i>
                                    @(user.Status)
                                </span>
                            </td>
                            <td class="pt-4 ps-3">
                                <script>
                                     @{
                                                string roleClass = user.Role switch
                                                {
                                                            "Admin" => "bg-purple-100 text-purple-700",
                                                            "Manager" => "bg-blue-100 text-blue-700",
                                                            "Staff" => "bg-green-100 text-green-700",
                                                            "Support" => "bg-orange-100 text-orange-700",
                                                            _ => "bg-gray-100 text-gray-700"
                                                };
                                                    string iconRole = user.Role switch
                                                    {
                                                                    "Admin" => "bi bi-shield - check",
                                                                    "Manager" => "bi bi-shield",
                                                                     _ => "bi bi-person-gear"
                                                    };
                                    }
                                </script>
                                <span class="badge px-3 py-2 rounded-pill shadow-sm @roleClass data-role">
                                    <i class="@iconRole fw-bold"></i>
                                    @user.Role
                                </span>
                            </td>
                            <td class="pt-4 ps-3">
                                <span class="badge text-secondary px-2 py-1 rounded-10 border small">
                                    @(user.Role == "Admin" ? "All Access" : string.Join(", ", user.Permission))
                                </span>
                            </td>
                            <td class="pt-4 ps-4 data-lastactive">@user.LastActive</td>
                            <td class="pt-4 ps-4 data-joindate">@user.JoinDate</td>
                            <td class="text-center pt-4 position-relative">

                                @* Action dropdown *@

                                <div class="dropdown">

                                    <a class="btn border-0" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical p-2 rounded-10"></i>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-rigth" aria-labelledby="dropdownMenuLink">
                                        <a class="dropdown-header small fw-bold" href="#">Action</a>
                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item small rounded-10 action-button" data-toggle="modal" data-target="#viewDetail">
                                            <i class="bi bi-eye"></i>
                                            <span class="ms-2">View Details</span>
                                        </button>
                                        <button class="dropdown-item small rounded-10 action-button" data-toggle="modal" data-target="#edit">
                                            <i class="bi bi-pencil-square"></i>
                                            <span class="ms-2"> Edit Role</span>
                                        </button>

                                        <div class="dropdown-divider"></div>
                                        <button class="dropdown-item small rounded-10 action-button" data-toggle="modal" data-target="#delete" href="#">
                                            <i class="bi bi-trash3"></i>
                                            <span class="text-danger ms-2">Delete Role</span>
                                        </button>
                                    </div>



                                    <!-- ViewDetail Modal -->
                                    <div class="modal fade" id="viewDetail" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" style="max-width:40%; margin:auto;" role="document">
                                            <div class="modal-content ">

                                                <div class="modal-header flex-column align-items-start mx-2">
                                                    <h5 class="modal-title fw-semibold" id="exampleModalLabel">User Details</h5>
                                                    <p class="text-muted mb-0">Complete information about this user</p>
                                                    <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true" class="fs-5">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body mx-2">
                                                    <div class="d-flex flex-row align-items-start">
                                                        <div class="custom-gradient rounded-circle border w-75px h-75px bg-light d-flex justify-content-center pt-2 border-0">
                                                            <h4 class="d-flex justify-content-center align-items-center" id="initial">@initials</h4>

                                                        </div>
                                                        <div class="d-flex flex-column align-items-start mt-1">
                                                            <h4 class="ms-3 fw-semibold" id="v-fullname">@user.FullName</h4>
                                                            <div class="d-flex flex-row text-gray-700 ms-3">
                                                                <i class="bi bi-envelope "></i>
                                                                <p class="ms-2" id="v-email">@user.Email</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="border-top w-100 "></div>

                                                    <div class="d-flex align-content-start row row-cols-2 ">
                                                        <div class="col d-flex flex-column align-items-start justify-content-between my-3">
                                                            <p class="mb-1">Role</p>
                                                            <span class="rounded-pill @roleClass px-2 py-1" id="v-role">
                                                                <i class="@iconRole fw-bold me-1"></i>
                                                                @user.Role
                                                            </span>
                                                        </div>
                                                        <div class="col d-flex flex-column align-items-start justify-content-start my-3">
                                                            <p class="mb-1">Status</p>
                                                            <span class="rounded-pill @badgeColor px-2 py-1" id="v-status">
                                                                <i class="@iconStatus fw-bold me-1"></i>
                                                                @user.Status
                                                            </span>
                                                        </div>
                                                        <div class="col d-flex flex-column align-items-start justify-content-start my-3">
                                                            <p class="mb-1">Join Date</p>
                                                            <div id="v-joindate">
                                                                <i class=" fw-bold me-1"></i>
                                                                @user.JoinDate
                                                            </div>
                                                        </div>
                                                        <div class="col d-flex flex-column align-items-start justify-content-start my-3">
                                                            <p class="mb-1">Last Active</p>
                                                            <div id="v-lastactive">
                                                                <i class="@iconStatus fw-bold me-1"></i>
                                                                @user.LastActive
                                                            </div>
                                                        </div>
                                                        <div class="col d-flex flex-column align-items-start justify-content-start my-3">
                                                            <p class="mb-1">Permissions</p>
                                                            <div class="d-flex flex-row">
                                                                @foreach (var p in user.Permission)
                                                                {
                                                                    var permission = p.Split("::");
                                                                    var endOfPermission = permission.Length > 1 ? permission[1] : "";

                                                                    <p class="badge text-secondary px-2 py-1 rounded-10 border small">
                                                                        @(string.Join(", ", endOfPermission))
                                                                    </p>
                                                                }
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="border-top w-100 "></div>
                                                    <div class="col d-flex flex-column align-items-start justify-content-start my-3">
                                                        <p class="mb-1">User Id</p>
                                                        <div id="v-id">#1</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">
                                                        <span>Close</span>
                                                    </button>
                                                    <button type="button" class="btn btn-dark rounded-2 d-flex" data-dismiss="modal" data-toggle="modal" data-target="#edit">
                                                        <i class="bi bi-pencil-square"></i>
                                                        <span class="ms-3">Edit User</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Delete Modal -->
                                    <form id="delete-user">
                                        <div class="modal fade" id="delete" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="exampleModalLongTitle">Delete User</h5>
                                                        <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                                            <span aria-hidden="true" class="fs-5">&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="border-top w-100 "></div>
                                                    <div class="modal-body d-flex flex-column align-items-start mx-2">
                                                        <input type="text" name="Id" id="d-id" hidden>
                                                        You sure you want to delete this user
                                                        <span id="d-fullname"></span>
                                                    </div>
                                                    <div class="border-top w-100 "></div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">No</button>
                                                        <button type="submit" class="btn btn-danger rounded-2">Yes</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </form>


                                    <!-- Edit Modal -->
                                    <div class="modal fade" id="edit" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" style="max-width:33%; margin:auto;" role="document">
                                            <div class="modal-content">
                                                <form id="edit-user">
                                                    @Html.AntiForgeryToken()

                                                    <div class="modal-header flex-column align-items-start mx-2">
                                                        <h5 class="modal-title fw-semibold" id="exampleModalLabel">Edit User</h5>
                                                        <p class="text-muted mb-0">Update user information, role, and permissions.</p>
                                                        <button type="button" class="close position-absolute end-0 top-0 m-2 px-2 border-0 bg-white" data-dismiss="modal" aria-label="Close">
                                                            <span aria-hidden="true" class="fs-5">&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body mx-2">
                                                        <div class="d-flex align-items-start flex-column justify-content-between">
                                                            <div class="d-flex align-items-start flex-column w-100 mb-2">

                                                                <input type="text" name="Id" id="id" hidden>
                                                                <label formlabel="Full Name">Full Name</label>
                                                                <input type="text" name="FullName" id="fullname" asp-for=@user.FullName class="form-input-field border-0 p-2 shadow-none bg-light my-1">
                                                            </div>
                                                            <div class="d-flex align-items-start flex-column w-100 my-2">
                                                                <label formlabel="Email">Email</label>
                                                                <input type="text" name="Email" id="email" asp-for=@user.Email class="form-input-field border-0 p-2 shadow-none bg-light my-1">
                                                            </div>
                                                            <div class="d-flex align-items-start flex-column w-100 my-2">
                                                                <label formlabel="Role">Role</label>
                                                                <select id="role" name="Role" style="padding:8px;padding-right:5px;border:none;width:100%;border-radius:10px;background-color:#f3f4f6;">
                                                                    @foreach (var role in ViewBag.RoleNames)
                                                                    {
                                                                        <option value=@role selected="@(user.Role == role)">
                                                                            @role
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="d-flex align-items-start flex-column w-100 my-2">
                                                                <label formlabel="Status">Status</label>
                                                                <select id="status" name="Status" style="padding:8px;padding-right:5px;border:none;width:100%;border-radius:10px;background-color:#f3f4f6;">
                                                                    <option value="InActive" selected=@(user.Role == "InActive")>
                                                                        InActive
                                                                    </option>
                                                                    <option value="Active" selected=@(user.Role == "Active")>
                                                                        Active
                                                                    </option>
                                                                    <option value="Suspended" selected=@(user.Role == "Suspended")>
                                                                        Suspended
                                                                    </option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn border bg-white rounded-2" data-dismiss="modal">
                                                            <span>Close</span>
                                                        </button>
                                                        <button type="submit" class="btn btn-dark rounded-2 d-flex">
                                                            <span>Save Changes</span>
                                                        </button>
                                                    </div>
                                                </form>

                                            </div>
                                        </div>
                                    </div>


                                </div>


                            </td>
                        </tr>
                    }

                    <tr>
                        <td colspan="5" class="pt-4 ps-4 small text-secondary border-0">
                            @{
                                var start = 0;
                                var end = 0;
                                if (Model.TotalCount != 0)
                                {
                                    start = (Model.PageNumber - 1) * Model.PageSize + 1;
                                    end = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
                                }
                            }
                            Showing @start to @end of @Model.TotalCount users
                        </td>
                        <td class="p-3 border-0 text-end">
                            <a class="btn btn-sm rounded-10 py-2 px-3 border
                                @(Model.PageNumber == 1 ? "disabled" : "")"
                               asp-page="/UserManagement/Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)">
                                Previous
                            </a>
                        </td>
                        <td class="p-3 border-0 text-start">
                            <a class="btn btn-sm rounded-10 py-2 px-3 border @(Model.PageNumber* Model.PageSize >= Model.TotalCount ? "disabled" : "")"
                               asp-page="/UserManagement/Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)">
                                Next
                            </a>
                        </td>
                    </tr>

                </tbody>

            </table>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {

        $(".action-button").click(function () {
            var row = $(this).closest("tr");


            var id = row.find(".data-id").text().trim();
            console.log(id);
            var initial = row.find(".data-initial").text().trim();
            var name   = row.find(".data-fullname").text().trim();
            var email  = row.find(".data-email").text().trim();
            var status = row.find(".data-status").text().trim();
            var role   = row.find(".data-role").text().trim();
            var lastactive = row.find(".data-lastactive").text().trim();
            var joindate = row.find(".data-joindate").text().trim();



            $("#id").val(id);
            $("#initial").val(initial);
            $("#fullname").val(name);
            $("#email").val(email);
            $("#status").val(status);
            $("#status").removeClass();
            @* $("#status").addClass("rounded-pill px-2 py-1"); *@
            $("#role").val(role);
            $("#role").removeClass();

            $("#v-id").text(id);
            $("#v-fullname").text(name);
            $("#v-email").text(email);
            $("#v-status").text(status);

                if (status === "Active") {
                    $("#v-status").addClass(" rounded-pill px-2 py-1 bg-green-100 text-green-700");
                }
                else if (status === "InActive") {
                    $("#v-status").addClass("rounded-pill px-2 py-1 bg-gray-100 text-gray-700");
                }
                else {
                    $("#v-status").addClass(" rounded-pill px-2 py-1 bg-red-100 text-red-700");
                }

                if (role === "Admin") {
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-purple-100 text-purple-700");
                }
                else if (role === "Manager") {
                    $("#v-role").addClass("rounded-pill px-2 py-1 bg-blue-100 text-blue-700");
                }
                else if (role === "Staff"){
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-green-100 text-green-700");
                }else if (role === "Support"){
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-orange-100 text-orange-700");
                }
                else{
                    $("#v-role").addClass(" rounded-pill px-2 py-1 bg-gray-100 text-gray-700");
                }

            $("#v-role").text(role);
            $("#v-lastactive").text(lastactive);
            $("#v-joindate").text(joindate);

            $("#d-fullname").text(name);
            $("#d-id").val(id);

        });

    });

</script>


<script>
    $(document).ready(function () {

        $('#edit-user').submit(function (e) {
            e.preventDefault();

            $.ajax({
                url: '/UserManagement/Update',
                type: 'POST',
                data: $('#edit-user').serialize(),

                success: function (response) {
                    alert(response.message);
                    location.reload();
                },

                error: function (xhr) {
                    alert("Update failed");
                }
            });

        });
        $('#add-user').submit(function (e) {
            e.preventDefault();

            $.ajax({
                url: '/UserManagement/Create',
                type: 'POST',
                data: $('#add-user').serialize(),

                success: function (response) {
                    alert(response.message);
                    location.reload();
                },

                error: function (xhr) {
                    alert("Create failed");
                }
            });

        });
        $('#delete-user').submit(function (e){
            e.preventDefault();

            $.ajax({
                url: '/UserManagement/Delete',
                type: 'POST',
                data: $('#delete-user').serialize(),

                success: function (response){
                    alert(response.message);
                    location.reload();
                },
                error: function (xhr) {
                    alert("Delete failed");
                }
            });
        });

    });
</script>