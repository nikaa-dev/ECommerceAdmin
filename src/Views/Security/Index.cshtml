@{
    Layout = "../Shared/_SettingLayout";
}

<style>
    .security-card { border: 1px solid #e9edf3; border-radius: 16px; background: #fff; box-shadow: 0 2px 10px rgba(15, 23, 42, .035); }
    .security-icon { width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: #eff6ff; color: #2563eb; font-size: 1.2rem; }
    .security-row + .security-row { border-top: 1px solid #eef1f5; }
    .security-input { border: 1px solid #dfe4ea; border-radius: 10px; min-height: 44px; }
    .security-input:focus { border-color: #4a6cf7; box-shadow: 0 0 0 .2rem rgba(74, 108, 247, .12); }
    .password-hint { color: #6b7280; font-size: .82rem; }
</style>

<div class="security-card mb-3">
    <div class="p-4 d-flex align-items-start gap-3">
        <div class="security-icon"><i class="bi bi-shield-check"></i></div>
        <div class="flex-grow-1">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h6 class="fw-bold mb-1">Your account is protected</h6>
                    <p class="text-secondary mb-0 small">Keep your password strong and review account access regularly.</p>
                </div>
                <span class="badge rounded-pill text-success bg-green-100 px-3 py-2">Security status: Good</span>
            </div>
        </div>
    </div>
</div>

<div class="security-card mb-3">
    <div class="p-4 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="security-icon"><i class="bi bi-key"></i></div>
            <div>
                <h6 class="fw-bold mb-1">Change password</h6>
                <p class="text-secondary mb-0 small">Use a unique password that you do not use on other websites.</p>
            </div>
        </div>
    </div>

    <form class="p-4" onsubmit="return false;">
        <div class="mb-3">
            <label for="current-password" class="form-label fw-medium small">Current password</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-secondary"></i></span>
                <input id="current-password" class="form-control security-input border-start-0" type="password" placeholder="Enter your current password" autocomplete="current-password" />
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="new-password" class="form-label fw-medium small">New password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock-fill text-secondary"></i></span>
                    <input id="new-password" class="form-control security-input border-start-0" type="password" placeholder="Create a new password" autocomplete="new-password" />
                </div>
            </div>
            <div class="col-md-6">
                <label for="confirm-password" class="form-label fw-medium small">Confirm new password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-check2-circle text-secondary"></i></span>
                    <input id="confirm-password" class="form-control security-input border-start-0" type="password" placeholder="Re-enter your new password" autocomplete="new-password" />
                </div>
            </div>
        </div>

        <p class="password-hint mt-3 mb-4"><i class="bi bi-info-circle me-1"></i>Use at least 8 characters with uppercase, lowercase, a number, and a symbol.</p>
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-primary px-4"><i class="bi bi-shield-lock me-2"></i>Update password</button>
        </div>
    </form>
</div>

<div class="security-card">
    <div class="p-4 border-bottom">
        <h6 class="fw-bold mb-1">Account security</h6>
        <p class="text-secondary mb-0 small">Review recent security activity and your signed-in devices.</p>
    </div>

    <div class="p-4 security-row d-flex align-items-center gap-3">
        <div class="security-icon"><i class="bi bi-clock-history"></i></div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">Recent sign-in activity</p>
            <p class="text-secondary small mb-0">Review successful sign-ins and unusual activity.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm">View activity</button>
    </div>

    <div class="p-4 security-row d-flex align-items-center gap-3">
        <div class="security-icon"><i class="bi bi-laptop"></i></div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">Active sessions</p>
            <p class="text-secondary small mb-0">Manage the devices currently signed in to this account.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm">Manage sessions</button>
    </div>
</div>
