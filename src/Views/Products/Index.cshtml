		$('#edit-product').on('submit',function(e){
			e.preventDefault();

			$.ajax({
				url: '/Products/Update',
				type: 'POST',
				data: $('#edit-product').serialize(),

				success: function (response) {
					alert(response.message);
					location.reload();
