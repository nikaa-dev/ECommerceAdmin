@{
    Layout = "../Shared/_SettingLayout";
}
@model src.DTO.UserDto.ProfileUserResponseDto

<style>
    .grid-container1 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .form-input-field {
        width: 100%;
        border-radius: 10px;
    }

    .full-width1 {
        grid-column: 1 / -1;
    }
</style>

<div class="col rounded-15 bg-white shadow-sm border">
    <div class="border-bottom ">
        <div class="m-4 ">
            
            <h6 class="fw-bold">
                Profile Picture
            </h6>
            <span class="text-secondary">
                Update your avatar and display photo
            </span>
            
        </div>        
    </div>
    <div>
        <div class="m-4 d-flex align-items-center">

            <!-- Avatar -->
            <div class="position-relative">
                <div class="rounded-circle bg-primary d-flex justify-content-center align-items-center"
                     style="width: 90px; height: 90px;">
                    <span class="text-white fw-bold fs-2">SD</span>
                </div>

                <!-- Camera button -->
                <button type="button"
                        class="position-absolute bg-white border rounded-circle shadow-sm d-flex justify-content-center align-items-center"
                        style="width: 34px; height: 34px; right: -5px; bottom: -5px;">
                    <i class="bi bi-camera text-secondary"></i>
                </button>
            </div>

            <!-- User information -->
            <div class="ms-4">
                <h6 class="mb-1 fs-5">@Model.FullName</h6>

                <p class="text-secondary d-block mb-2">
                    @Model.RoleName
                </p>

                <div class="d-flex align-items-center gap-4">
                    <button type="button"
                            class="btn btn-outline-secondary rounded-3 px-2 py-1">
                        Upload Photo
                    </button>

                    <button type="button"
                            class="btn btn-link text-danger text-decoration-none p-0">
                        Remove
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="col rounded-15 bg-white shadow-sm border mt-3">
    <div class="border-bottom ">
        <div class="m-4 ">
            
            <h6 class="fw-bold">
                Personal Information
            </h6>
            <span class="text-secondary">
                Your name, contact details and bio
            </span>
            
        </div>        
    </div>
    <div>
        <div class="grid-container1 py-4 px-4">
            <div class="d-flex align-items-start flex-column w-100 mb-2">
                <div>
                    <i class="bi bi-person"></i>
                    <label>Full Name</label>
                </div>
                <input readonly value=@Model.FullName asp-for="FullName" class="form-input-field border-0 pt-2 pb-2 ps-2 shadow-none bg-light" />
            </div>
            <div class="d-flex align-items-start flex-column w-100 mb-2">
                <div>
                    <i class="bi bi-envelope"></i>
                    <label>Email Address</label>
                </div>
                <input readonly value=@Model.Email class="form-input-field border-0 pt-2 pb-2 ps-2 shadow-none bg-light" />
            </div>
            <div class="d-flex align-items-start flex-column w-100 mb-2">
                <div>
                    <i class="bi bi-telephone"></i>
                    <label>Phone Number</label>
                </div>
                <input readonly value=@Model.PhoneNumber class="form-input-field border-0 pt-2 pb-2 ps-2 shadow-none bg-light" />
            </div>
            <div class="d-flex align-items-start flex-column w-100 mb-2">
                <div>
                    <i class="bi bi-building"></i>
                    <label>Company</label>
                </div>
                <input readonly value=@Model.Company class="form-input-field border-0 pt-2 pb-2 ps-2 shadow-none bg-light" />
            </div>
            <div class="d-flex align-items-start flex-column w-100 mb-2 full-width1">
                <div>
                    <i class="bi bi-geo-alt"></i>
                    <label>Address</label>
                </div>
                <input readonly value=@Model.Address class="form-input-field border-0 pt-2 pb-2 ps-2 shadow-none bg-light" />
            </div>
            <div class="full-width1">
                <span>Bio</span>
                <div class="border rounded-3 py-2 px-3">

                    <textarea name="Description"
                              id="e-product-description"
                              class="w-100 border-0"
                              style="height:60px; resize:none; outline:none;">E-commerce administrator managing store operations.</textarea>
                </div>
            </div>
            
        </div>
        <div class="pe-4 pb-4 d-flex justify-content-end align-items-end">

            <div class="d-flex align-items-center">
                <!-- Back Link (Navigates to List/Index) -->
                <div class="me-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back
                    </a>
                </div>

                <!-- Update Link (Navigates to Update/Edit View) -->
                <div>
                    <!-- ដូរ 'Product', 'Edit', និង '@Model.Id' ទៅតាមកូដពិតប្រាកដរបស់អ្នក -->
                    <a asp-controller="Profile" asp-action="Update"  class="btn btn-primary">
                        <i class="bi bi-pencil-square me-2"></i> <!-- ប្តូរ icon ទៅ pencil អោយសក្តិសមនឹងការ Edit -->
                        Update
                    </a>
                </div>
            </div>
            
        </div>
        
    </div>
</div>