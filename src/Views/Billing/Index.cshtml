@{
    Layout = "../Shared/_SettingLayout";
}

<style>
    .billing-card { border: 1px solid #e9edf3; border-radius: 16px; background: #fff; box-shadow: 0 2px 10px rgba(15, 23, 42, .035); }
    .billing-icon { width: 44px; height: 44px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: #eff6ff; color: #2563eb; font-size: 1.15rem; flex-shrink: 0; }
    .billing-row + .billing-row { border-top: 1px solid #eef1f5; }
    .plan-banner { background: linear-gradient(115deg, #eff6ff, #f8fbff); border: 1px solid #dbeafe; border-radius: 13px; }
    .plan-price { color: #1d4ed8; font-size: 1.55rem; font-weight: 700; }
    .invoice-table th { color: #6b7280; font-size: .77rem; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; background: #f8fafc; }
    .invoice-table td, .invoice-table th { padding: .9rem 1rem; vertical-align: middle; }
    .invoice-table tbody tr:last-child td { border-bottom: 0; }
    .payment-brand { width: 45px; height: 30px; border: 1px solid #e5e7eb; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; color: #1a56db; font-size: .75rem; font-weight: 700; letter-spacing: -.05em; }
</style>

<div class="billing-card mb-3">
    <div class="p-4 border-bottom d-flex align-items-center gap-3">
        <div class="billing-icon"><i class="bi bi-receipt"></i></div>
        <div>
            <h6 class="fw-bold mb-1">Billing & subscription</h6>
            <p class="text-secondary small mb-0">Manage your plan, payment method, and billing history.</p>
        </div>
    </div>

    <div class="p-4">
        <div class="plan-banner p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2"><span class="badge bg-primary rounded-pill px-3 py-2">Current plan</span><span class="fw-semibold">Business</span></div>
                <p class="text-secondary small mb-0">Your plan renews automatically on <strong class="text-dark">29 September 2026</strong>.</p>
            </div>
            <div class="text-md-end">
                <p class="plan-price mb-0">$49<span class="fs-6 fw-normal text-secondary">/month</span></p>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2">Manage plan</button>
            </div>
        </div>
    </div>
</div>

<div class="billing-card mb-3">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center gap-3">
        <div>
            <h6 class="fw-bold mb-1">Payment method</h6>
            <p class="text-secondary small mb-0">The card used for your subscription payments.</p>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Update</button>
    </div>

    <div class="p-4 d-flex align-items-center gap-3">
        <div class="payment-brand">VISA</div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">Visa ending in 4242</p>
            <p class="text-secondary small mb-0">Expires 08/2028</p>
        </div>
        <span class="badge text-success bg-green-100 rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Default</span>
    </div>
</div>

<div class="billing-card">
    <div class="p-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h6 class="fw-bold mb-1">Billing history</h6>
            <p class="text-secondary small mb-0">Download invoices and view previous payments.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i>Download all</button>
    </div>

    <div class="table-responsive">
        <table class="table invoice-table mb-0">
            <thead><tr><th>Invoice</th><th>Date</th><th>Amount</th><th>Status</th><th class="text-end"> </th></tr></thead>
            <tbody>
                <tr><td><span class="fw-semibold">INV-2026-008</span></td><td class="text-secondary">29 Aug 2026</td><td>$49.00</td><td><span class="badge text-success bg-green-100 rounded-pill px-3 py-2">Paid</span></td><td class="text-end"><button type="button" class="btn btn-link btn-sm text-primary text-decoration-none">Download</button></td></tr>
                <tr><td><span class="fw-semibold">INV-2026-007</span></td><td class="text-secondary">29 Jul 2026</td><td>$49.00</td><td><span class="badge text-success bg-green-100 rounded-pill px-3 py-2">Paid</span></td><td class="text-end"><button type="button" class="btn btn-link btn-sm text-primary text-decoration-none">Download</button></td></tr>
                <tr><td><span class="fw-semibold">INV-2026-006</span></td><td class="text-secondary">29 Jun 2026</td><td>$49.00</td><td><span class="badge text-success bg-green-100 rounded-pill px-3 py-2">Paid</span></td><td class="text-end"><button type="button" class="btn btn-link btn-sm text-primary text-decoration-none">Download</button></td></tr>
            </tbody>
        </table>
    </div>
</div>
