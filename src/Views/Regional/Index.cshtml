@{
    Layout = "../Shared/_SettingLayout";
}

<style>
    .regional-card { border: 1px solid #e9edf3; border-radius: 16px; background: #fff; box-shadow: 0 2px 10px rgba(15, 23, 42, .035); }
    .regional-icon { width: 44px; height: 44px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: inline-flex; align-items: center; justify-content: center; font-size: 1.15rem; flex-shrink: 0; }
    .regional-label { font-size: .88rem; font-weight: 600; color: #374151; margin-bottom: .45rem; }
    .regional-select { min-height: 45px; border-color: #dfe4ea; border-radius: 10px; color: #374151; }
    .regional-select:focus { border-color: #4a6cf7; box-shadow: 0 0 0 .2rem rgba(74, 108, 247, .12); }
    .regional-row + .regional-row { border-top: 1px solid #eef1f5; }
    .regional-preview { background: #f8fafc; border: 1px dashed #d9e1eb; border-radius: 12px; }
    .preview-item + .preview-item { border-left: 1px solid #e5e7eb; }
</style>

<div class="regional-card mb-3">
    <div class="p-4 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="regional-icon"><i class="bi bi-globe2"></i></div>
            <div>
                <h6 class="fw-bold mb-1">Regional preferences</h6>
                <p class="text-secondary small mb-0">Set the language, time zone, and formats used throughout your workspace.</p>
            </div>
        </div>
    </div>

    <div class="p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <label for="language" class="regional-label">Language</label>
                <select id="language" class="form-select regional-select">
                    <option selected>English (United States)</option>
                    <option>Khmer (Cambodia)</option>
                    <option>English (United Kingdom)</option>
                </select>
                <p class="text-secondary small mt-2 mb-0">Used for menus, labels, and system messages.</p>
            </div>
            <div class="col-md-6">
                <label for="timezone" class="regional-label">Time zone</label>
                <select id="timezone" class="form-select regional-select">
                    <option selected>(GMT+07:00) Phnom Penh</option>
                    <option>(GMT+07:00) Bangkok</option>
                    <option>(GMT+08:00) Singapore</option>
                </select>
                <p class="text-secondary small mt-2 mb-0">Used for dates, reports, and account activity.</p>
            </div>
        </div>
    </div>
</div>

<div class="regional-card mb-3">
    <div class="p-4 border-bottom">
        <h6 class="fw-bold mb-1">Formats</h6>
        <p class="text-secondary small mb-0">Choose how dates, times, and amounts are displayed.</p>
    </div>

    <div class="p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <label for="date-format" class="regional-label">Date format</label>
                <select id="date-format" class="form-select regional-select">
                    <option selected>DD/MM/YYYY</option>
                    <option>MM/DD/YYYY</option>
                    <option>YYYY-MM-DD</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="time-format" class="regional-label">Time format</label>
                <select id="time-format" class="form-select regional-select">
                    <option selected>24-hour time</option>
                    <option>12-hour time</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="currency" class="regional-label">Currency</label>
                <select id="currency" class="form-select regional-select">
                    <option selected>USD — US Dollar ($)</option>
                    <option>KHR — Cambodian Riel (៛)</option>
                    <option>THB — Thai Baht (฿)</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="number-format" class="regional-label">Number format</label>
                <select id="number-format" class="form-select regional-select">
                    <option selected>1,234.56</option>
                    <option>1.234,56</option>
                    <option>1 234,56</option>
                </select>
            </div>
        </div>

        <div class="regional-preview mt-4 p-3">
            <p class="text-secondary fw-semibold small text-uppercase mb-3">Preview</p>
            <div class="row g-0 text-center">
                <div class="col-4 px-2"><p class="text-secondary small mb-1">Date & time</p><p class="fw-semibold mb-0">29/08/2026, 14:30</p></div>
                <div class="col-4 px-2 preview-item"><p class="text-secondary small mb-1">Currency</p><p class="fw-semibold mb-0">$1,234.56</p></div>
                <div class="col-4 px-2 preview-item"><p class="text-secondary small mb-1">Number</p><p class="fw-semibold mb-0">12,345.67</p></div>
            </div>
        </div>
    </div>
</div>

<div class="regional-card">
    <div class="p-4 regional-row d-flex align-items-center gap-3">
        <div class="regional-icon"><i class="bi bi-calendar-week"></i></div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">First day of the week</p>
            <p class="text-secondary small mb-0">Set the starting day shown in calendars and reports.</p>
        </div>
        <select class="form-select regional-select" style="max-width: 150px;"><option selected>Monday</option><option>Sunday</option></select>
    </div>
    <div class="p-4 d-flex justify-content-end">
        <button type="button" class="btn btn-primary px-4"><i class="bi bi-check2 me-2"></i>Save preferences</button>
    </div>
</div>
