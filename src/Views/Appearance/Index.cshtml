@{
    Layout = "../Shared/_SettingLayout";
}

<style>
    .appearance-card { border: 1px solid #e9edf3; border-radius: 16px; background: #fff; box-shadow: 0 2px 10px rgba(15, 23, 42, .035); }
    .theme-option { position: relative; display: block; cursor: pointer; }
    .theme-option input { position: absolute; opacity: 0; pointer-events: none; }
    .theme-preview { border: 2px solid #e5e7eb; border-radius: 14px; overflow: hidden; transition: border-color .2s, box-shadow .2s; }
    .theme-option input:checked + .theme-preview { border-color: #4a6cf7; box-shadow: 0 0 0 3px rgba(74, 108, 247, .12); }
    .theme-topbar { height: 28px; display: flex; align-items: center; gap: 5px; padding: 0 10px; }
    .theme-dot { width: 6px; height: 6px; border-radius: 50%; opacity: .7; }
    .theme-body { height: 128px; padding: 15px; display: flex; gap: 12px; }
    .theme-sidebar { width: 25%; border-radius: 7px; }
    .theme-content { flex: 1; display: flex; flex-direction: column; gap: 9px; }
    .theme-line { height: 9px; border-radius: 5px; }
    .theme-line.short { width: 57%; }
    .theme-widgets { display: flex; gap: 8px; margin-top: 4px; }
    .theme-widget { flex: 1; height: 45px; border-radius: 7px; }
    .light-preview .theme-topbar { background: #f8fafc; border-bottom: 1px solid #e5e7eb; }
    .light-preview .theme-dot { background: #94a3b8; }
    .light-preview .theme-body { background: #fff; }
    .light-preview .theme-sidebar { background: #eff6ff; }
    .light-preview .theme-line { background: #cbd5e1; }
    .light-preview .theme-widget { background: #f1f5f9; }
    .dark-preview .theme-topbar { background: #172033; border-bottom: 1px solid #334155; }
    .dark-preview .theme-dot { background: #94a3b8; }
    .dark-preview .theme-body { background: #111827; }
    .dark-preview .theme-sidebar { background: #1e3a5f; }
    .dark-preview .theme-line { background: #64748b; }
    .dark-preview .theme-widget { background: #1f2937; }
    .selection-check { position: absolute; top: 12px; right: 12px; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #4a6cf7; color: #fff; opacity: 0; transform: scale(.8); transition: .2s; }
    .theme-option input:checked ~ .selection-check { opacity: 1; transform: scale(1); }
    .appearance-row + .appearance-row { border-top: 1px solid #eef1f5; }
    .appearance-icon { width: 42px; height: 42px; border-radius: 11px; background: #eff6ff; color: #2563eb; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; }
</style>

<div class="appearance-card mb-3">
    <div class="p-4 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <div class="appearance-icon"><i class="bi bi-palette"></i></div>
            <div>
                <h6 class="fw-bold mb-1">Theme</h6>
                <p class="text-secondary small mb-0">Choose how the admin workspace looks to you.</p>
            </div>
        </div>
    </div>

    <div class="p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <label class="theme-option">
                    <input type="radio" name="theme" checked />
                    <div class="theme-preview light-preview">
                        <div class="theme-topbar"><span class="theme-dot"></span><span class="theme-dot"></span><span class="theme-dot"></span></div>
                        <div class="theme-body">
                            <div class="theme-sidebar"></div>
                            <div class="theme-content">
                                <div class="theme-line"></div>
                                <div class="theme-line short"></div>
                                <div class="theme-widgets"><div class="theme-widget"></div><div class="theme-widget"></div></div>
                            </div>
                        </div>
                    </div>
                    <span class="selection-check"><i class="bi bi-check-lg"></i></span>
                    <span class="d-flex align-items-center justify-content-between mt-3 px-1"><span class="fw-semibold">Light</span><span class="text-secondary small">Bright and clean</span></span>
                </label>
            </div>

            <div class="col-md-6">
                <label class="theme-option">
                    <input type="radio" name="theme" />
                    <div class="theme-preview dark-preview">
                        <div class="theme-topbar"><span class="theme-dot"></span><span class="theme-dot"></span><span class="theme-dot"></span></div>
                        <div class="theme-body">
                            <div class="theme-sidebar"></div>
                            <div class="theme-content">
                                <div class="theme-line"></div>
                                <div class="theme-line short"></div>
                                <div class="theme-widgets"><div class="theme-widget"></div><div class="theme-widget"></div></div>
                            </div>
                        </div>
                    </div>
                    <span class="selection-check"><i class="bi bi-check-lg"></i></span>
                    <span class="d-flex align-items-center justify-content-between mt-3 px-1"><span class="fw-semibold">Dark</span><span class="text-secondary small">Easy on the eyes</span></span>
                </label>
            </div>
        </div>

        <p class="text-secondary small mb-0 mt-4"><i class="bi bi-info-circle me-1"></i>Your theme choice will be applied across the workspace.</p>
    </div>
</div>

<div class="appearance-card">
    <div class="p-4 border-bottom">
        <h6 class="fw-bold mb-1">Display preferences</h6>
        <p class="text-secondary small mb-0">Personalize the way content is presented.</p>
    </div>

    <div class="p-4 appearance-row d-flex align-items-center gap-3">
        <div class="appearance-icon"><i class="bi bi-layout-text-window-reverse"></i></div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">Compact navigation</p>
            <p class="text-secondary small mb-0">Use a narrower sidebar to create more workspace.</p>
        </div>
        <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" /></div>
    </div>

    <div class="p-4 appearance-row d-flex align-items-center gap-3">
        <div class="appearance-icon"><i class="bi bi-sun"></i></div>
        <div class="flex-grow-1">
            <p class="fw-semibold mb-1">Reduce motion</p>
            <p class="text-secondary small mb-0">Minimize animations and transitions throughout the interface.</p>
        </div>
        <div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" role="switch" /></div>
    </div>
</div>
