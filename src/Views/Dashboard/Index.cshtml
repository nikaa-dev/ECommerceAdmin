        <div class="col bg-white p-4 m-3 rounded-10 border shadow-sm">
            <h5 class="m-2">Orders Overview</h5>
            <canvas id="barchart" style="width:100%;max-width:600px"></canvas>

            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

            <script>
                const x = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"];
                const y = [55, 49, 44, 24, 15, 20];

                new Chart("barchart", {
                  type: "bar",
                  data: {
                    labels: x,
                    datasets: [{
                      label: "Orders",
                      backgroundColor: "#2563eb",
                      borderRadius: 6,
                      data: y
                    }]
                  },
                  options: {
                    responsive: true,
                    plugins: {
                      legend: { display: false },
                      // title: {
                      //   display: true,
                      //   text: "Monthly Orders"
                      // }
                    },
                    scales: {
                      y: {
                        beginAtZero: true
                      }
                    }
                  }
                });
            </script>
        </div>
  </div>
  
  <div class="row d-flex">
    <div class="col bg-white p-4 m-3 rounded-10 border shadow-sm">
      <h5 class="m-2">Top Products</h5>
      <table class="table bg-black">
        <tbody>
            @* @foreach (var products in Model.TopProducts)
